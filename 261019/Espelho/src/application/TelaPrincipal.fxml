<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Reflection?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/22" fx:controller="application.ControleAplicacao">
   <children>
      <VBox fx:id="raiz" layoutX="10.0" layoutY="10.0" prefHeight="200.0" prefWidth="215.0">
         <children>
            <HBox fx:id="hbTopo" prefHeight="100.0" prefWidth="150.0">
               <children>
                  <TextField fx:id="txtNome" />
                  <Button fx:id="btnAcao" mnemonicParsing="false" onAction="#atualizaMensagem" text="Clique!" />
               </children>
            </HBox>
            <Label fx:id="lblMensagem" text="Digite seu nome e clique no botão!">
               <effect>
                  <Reflection />
               </effect>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
